# ============================================================
# 生产环境变量模板。在服务器上复制为 deploy/.env 再填写（步骤见 deploy/README.md）：
#   cp env.production.example .env && chmod 600 .env
#
# deploy/.env 同时供两处使用：
#   · docker compose 解析 docker-compose.yml 里的 ${...}（MySQL 密码、端口、软件源……）；
#   · web 容器的环境变量（env_file），Django 从这里读配置。
#
# 格式约定：
#   · 注释单独占一行，不要写在值的后面；
#   · 值里不要出现 $、空格、引号（compose 会把 $ 当变量引用）。
#     下面给的随机值生成命令只产出十六进制字符，可放心粘贴。
#
# deploy/.env 已被 .gitignore 的 .env 规则排除。真实密钥只写在服务器上的 deploy/.env，
# 不要写进本模板，也不要提交到仓库。
# ============================================================

# ── 必填：密钥与数据库密码 ───────────────────────────────────
# Django 密钥，生成：openssl rand -hex 32
SECRET_KEY=
# MySQL root 密码，只给 MySQL 容器初始化用（Django 不用 root 连库）。生成：openssl rand -hex 16
MYSQL_ROOT_PASSWORD=
# Django 连库的普通账号，MySQL 容器首次启动时自动创建（库名、用户名、密码）。
# DB_USER 不能填 root（MySQL 镜像不允许）。生成密码：openssl rand -hex 16
DB_NAME=acm_oj
DB_USER=acm_oj
DB_PASSWORD=

# ── 访问地址 ─────────────────────────────────────────────────
# 生产必须关闭（docker-compose.yml 也会强制为 False）
DEBUG=False
# 浏览器访问用的主机名：公网 IP 或域名，多个用英文逗号分隔，不带 http:// 和端口
ALLOWED_HOSTS=your-server-ip
# 前端和接口经同一个 nginx 同源访问，CORS 实际用不到；填站点地址（带协议）即可
CORS_ORIGINS=http://your-server-ip
# 一般留空。只有前面再套一层反代 / CDN、Django 后台登录报 CSRF 来源不匹配时才填，如 https://oj.example.com
CSRF_TRUSTED_ORIGINS=
# nginx 对外端口，阿里云安全组需放行
HTTP_PORT=80
HTTPS_PORT=443
# 启用 HTTPS 时改为 site-https.conf 并把 USE_HTTPS 设为 True（见 README「启用 HTTPS」）
NGINX_SITE_CONF=site-http.conf
USE_HTTPS=False

# ── 大模型（星语画像 / 任务改造 / 对话辅导 / 学习报告与 AI 反馈共用） ──
# 留空则禁用：星语走规则兜底，任务只能用"默认版本"生成
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat
# AI 反馈的后台并发（每个 gunicorn 进程各一份）
AI_FEEDBACK_WORKERS=2

# ── RAG 向量检索（可选；留空时 AI 问答退回关键词检索） ─────────
# 若导入了本机数据库里的向量，这三项要与生成向量时的配置一致
EMBED_API_KEY=
EMBED_API_BASE=
EMBED_MODEL=

# ── 进程数与评测并发（关系见 deploy/gunicorn.conf.py 顶部注释） ──
# 评测总并发 = GUNICORN_WORKERS × JUDGE_WORKERS，按 CPU 核数配（每个评测容器约占 1 核）
# 2 核：2 × 1；4 核：2 × 2
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
JUDGE_WORKERS=1
# 自定义运行 / 星语排序题的并发（每进程）；0 = 取 JUDGE_WORKERS 的一半，至少 1
JUDGE_RUN_WORKERS=0
JUDGE_RUN_QUEUE_WAIT=15.0
JUDGE_OUTPUT_LIMIT_KB=65536
JUDGE_SANDBOX_RUN_USER=nobody
JUDGE_SANDBOX_NOFILE=1024
JUDGE_DOCKER_IMAGE=acm-oj-sandbox:latest

# ── 沙箱与缓存（docker-compose.yml 会强制为下面的值，写在这里只为说明） ──
# 生产必须用 Docker 沙箱隔离执行学生代码
USE_DOCKER_SANDBOX=True
# 限流计数放 Redis，多个 gunicorn 进程共享同一份计数（否则每个进程各算各的，限流形同放大 N 倍）
REDIS_URL=redis://redis:6379/1
# 另外固定注入：DB_HOST=db、DB_PORT=3306、TMPDIR=/var/lib/acm-oj/judge_tmp

# ── 接口限流 ─────────────────────────────────────────────────
THROTTLE_ANON=300/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=30/hour
THROTTLE_SUBMIT=30/min
THROTTLE_RUN=30/min
THROTTLE_AI=30/hour
THROTTLE_STAR_AI=120/hour

# ── 日志 ─────────────────────────────────────────────────────
# Django 日志级别（输出到容器日志，docker compose logs web 查看）
LOG_LEVEL=INFO

# ── 构建镜像用的软件源（国内服务器保留以加速；海外服务器可清空，走官方源） ──
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com
