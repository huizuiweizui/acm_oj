# ============================================================
# 复制为 .env 并填写真实值。.env 已加入 .gitignore，禁止提交。
# 生成安全 SECRET_KEY：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ============================================================

# ── 必填（缺失时 Django 启动即报错） ─────────────────────────
SECRET_KEY=your-secret-key-here
DB_PASSWORD=your-mysql-password

# ── 环境模式 ─────────────────────────────────────────────────
# 开发：DEBUG=True，ALLOWED_HOSTS=localhost,127.0.0.1
# 生产：DEBUG=False，ALLOWED_HOSTS=your-domain.com
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── 数据库 ───────────────────────────────────────────────────
DB_NAME=acm_oj
DB_USER=root
DB_HOST=127.0.0.1
DB_PORT=3306

# ── 跨域（开发填 Vue 开发服务器，生产填前端域名） ────────────
CORS_ORIGINS=http://localhost:5173

# ── 评测队列与资源上限 ───────────────────────────────────────
# 同时最多跑几个评测（按评测机核数配；多进程部署时总并发 = 进程数 × 此值）
JUDGE_WORKERS=4
# 单测试点输出硬上限(KB)，超出判 OLE，防止程序狂打印撑爆评测机内存
JUDGE_OUTPUT_LIMIT_KB=65536
# 自定义运行（题目页"运行"按钮）的并发上限，与评测名额独立，抢不走判题 worker
# 0 = 取 JUDGE_WORKERS 的一半（至少 1）
JUDGE_RUN_WORKERS=0
# 排不到运行名额时最多等几秒，超时回 503
JUDGE_RUN_QUEUE_WAIT=15.0

# ── Docker 沙箱加固（仅 USE_DOCKER_SANDBOX=True 时生效） ─────
# 运行容器内的非 root 用户；若挂载权限异常导致评测失败，可置空临时退回 root
JUDGE_SANDBOX_RUN_USER=nobody
JUDGE_SANDBOX_NOFILE=1024

# ── 沙箱隔离（生产必须设为 True） ────────────────────────────
# 需提前构建镜像：docker build -f Dockerfile.sandbox -t acm-oj-sandbox:latest .
USE_DOCKER_SANDBOX=False
JUDGE_DOCKER_IMAGE=acm-oj-sandbox:latest

# ── 缓存（限流计数依赖；留空用进程内存，多进程部署建议配 Redis） ─
# REDIS_URL=redis://127.0.0.1:6379/1

# ── 接口限流（留空用默认值） ─────────────────────────────────
THROTTLE_ANON=300/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=30/hour
THROTTLE_SUBMIT=30/min
THROTTLE_RUN=30/min
THROTTLE_AI=30/hour

# ── AI 反馈（可选，留空则禁用） ──────────────────────────────
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
# AI 反馈的后台并发上限（每个 worker 挂一次 LLM 请求 + 一条数据库连接）
AI_FEEDBACK_WORKERS=2
