# ============================================================
# 复制为 .env 并填写真实值。.env 已加入 .gitignore，禁止提交。
# 生成安全 SECRET_KEY：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ============================================================

# ── 必填（缺失时 Django 启动即报错） ─────────────────────────
SECRET_KEY=your-secret-key-here
DB_PASSWORD=your-mysql-password

# ── 环境模式 ─────────────────────────────────────────────────
# 开发：DEBUG=True，ALLOWED_HOSTS=localhost,127.0.0.1
# 生产：DEBUG=False，ALLOWED_HOSTS=your-domain.com
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── 数据库 ───────────────────────────────────────────────────
DB_NAME=acm_oj
DB_USER=root
DB_HOST=127.0.0.1
DB_PORT=3306

# ── 跨域（开发填 Vue 开发服务器，生产填前端域名） ────────────
CORS_ORIGINS=http://localhost:5173

# ── 沙箱隔离（生产必须设为 True） ────────────────────────────
# 需提前构建镜像：docker build -f Dockerfile.sandbox -t acm-oj-sandbox:latest .
USE_DOCKER_SANDBOX=False
JUDGE_DOCKER_IMAGE=acm-oj-sandbox:latest

# ── AI 反馈（可选，留空则禁用） ──────────────────────────────
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# ── 异步任务队列 Celery（评测 + AI 反馈）─────────────────────
# 评测改为后台 worker 执行。开发二选一：
#   A) 简单：不装 Redis，保持 DEBUG=True 即可（自动同步执行，行为同以前）
#   B) 真实队列：装并启动 Redis，设 CELERY_TASK_ALWAYS_EAGER=False，
#      另开一个终端运行 worker：
#        celery -A acm_oj worker -l info --pool=solo   （Windows 本地）
#        celery -A acm_oj worker -l info               （Linux 生产）
REDIS_URL=redis://127.0.0.1:6379/0
# 留空跟随 DEBUG（开发同步 / 生产异步）；需要显式控制时取消下行注释：
# CELERY_TASK_ALWAYS_EAGER=False
# 生产：同时最多几个评测（= 并发 Docker 容器数，按 CPU 核数设）
CELERY_WORKER_CONCURRENCY=4
