# Judge sandbox image — contains all supported language runtimes.
# Build: docker build -f Dockerfile.sandbox -t acm-oj-sandbox:latest .
# The image is used by judge/services/sandbox.py when USE_DOCKER_SANDBOX=True.
#
# Security layers applied at runtime (see sandbox.py):
#   --network=none   --memory=Xm   --cpus=1   --pids-limit=64
#   --cap-drop=ALL   --security-opt no-new-privileges   --read-only   --ulimit nofile
#   --user nobody (run stage)   -v tmp:/sandbox:ro   --tmpfs /tmp:exec,size=128m

FROM debian:bookworm-slim

# 可选：国内服务器构建时换 apt 源加速，如 --build-arg APT_MIRROR=mirrors.aliyun.com
# （deploy/docker-compose.yml 会从 deploy/.env 传入）。留空则用 Debian 官方源。
ARG APT_MIRROR=
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        default-jdk-headless \
        python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /sandbox
